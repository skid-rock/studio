{
  "// назначение": "Типизация спайка STUDIO-008 на Craft.js. Отдельно от корневого",
  "// назначение2": "tsconfig, в прод-сборку (tsc --noEmit по корневому include) не входит.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client", "node"]
  },
  "include": [".", "../../src"]
}
