{
    "name": "studio",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "predev": "npm run tokens",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "tokens": "tsx src/tokens/build.mts",
        "export": "tsx scripts/export.mts",
        "figma:inventory": "tsx scripts/figma/inventory.mts",
        "figma:export": "tsx scripts/figma/export-asset.mts",
        "figma:check": "tsx scripts/figma/check-section.mts",
        "pretest": "npm run tokens",
        "test": "vitest run",
        "verify": "npm run tokens && npm run lint && npm run build && npm run test",
        "test:e2e": "playwright test",
        "verify:e2e": "npm run verify && npm run test:e2e",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@dnd-kit/dom": "0.5.0",
        "@dnd-kit/react": "0.5.0",
        "fractional-indexing": "^3.2.0",
        "nanoid": "^5.1.15",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "happy-dom": "^20.10.6",
        "prettier": "^3.8.4",
        "style-dictionary": "^5.4.4",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^8.0.16",
        "vitest": "^4.1.9"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "fsevents@2.3.3": true
    }
}
