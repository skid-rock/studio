{
    "name": "studio",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "predev": "npm run tokens",
        "build": "tsc --noEmit && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "tokens": "tsx src/tokens/build.mts",
        "export": "tsx scripts/export.mts",
        "pretest": "npm run tokens",
        "test": "vitest run",
        "verify": "npm run tokens && npm run lint && npm run build && npm run test",
        "test:watch": "vitest",
        "spike": "vite --config spikes/editor/vite.config.ts",
        "spike:verify": "tsx spikes/editor/verify.mts",
        "spike:craft": "vite --config spikes/editor-craft/vite.config.ts",
        "spike:craft:verify": "tsx spikes/editor-craft/verify.mts"
    },
    "dependencies": {
        "@measured/puck": "^0.20.2",
        "fractional-indexing": "^3.2.0",
        "nanoid": "^5.1.15",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@craftjs/core": "^0.2.12",
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.3",
        "globals": "^17.6.0",
        "prettier": "^3.8.4",
        "style-dictionary": "^5.4.4",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.61.1",
        "vite": "^8.0.16",
        "vitest": "^4.1.9"
    },
    "allowScripts": {
        "esbuild@0.25.12": true,
        "fsevents@2.3.3": true
    }
}
