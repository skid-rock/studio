# Согласовано с .prettierrc.json (отступы, пробелы в {}).
#
# Стандартные ключи — для любого редактора с EditorConfig.
# ij_* — расширения JetBrains (WebStorm, IDEA); остальные IDE их игнорируют.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}]
# indent_style/indent_size наследуются из [*]
# import { useMemo } from 'react'
ij_javascript_spaces_within_imports = true
ij_typescript_spaces_within_imports = true
# return { body: x }; fn({ registry: r }); JSX: {{ __html: x }}
ij_javascript_spaces_within_object_literal_braces = true
ij_typescript_spaces_within_object_literal_braces = true
